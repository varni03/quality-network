APP_USERNAME=demo
APP_PASSWORD=change-me
SECRET_KEY=change-me-to-a-long-random-string
REQUIRE_AUTH=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-8-chars-min

# Hardening (all optional)
# APP_ENV=production            # refuses to start while APP_PASSWORD / SECRET_KEY are still the published defaults
# TRUSTED_PROXY_COUNT=1         # reverse proxies in front of the app (Render/Vercel: 1). 0 = ignore X-Forwarded-For
# LOGIN_MAX_FAILURES=5          # failed sign-ins per IP before a lockout
# LOGIN_LOCKOUT_SECONDS=900
# ALLOWED_ORIGINS=              # empty = same-origin only; comma-separate origins to allow others
# DB_POOL_SIZE=20               # database connections; keep pool + overflow >= 40 (the sync worker thread pool)
# DB_MAX_OVERFLOW=30
